PORT=8080
# Choose a currently supported Graph API version in your Meta app dashboard.
META_GRAPH_VERSION=vXX.X
META_APP_SECRET=replace-with-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verification-token
ORGANIZATIONS_FILE=./config.local.json
LIBRARY_API_KEY=replace-with-a-unique-random-key-of-at-least-32-characters
LIBRARY_META_ACCESS_TOKEN=replace-with-meta-system-user-access-token
RESTAURANT_API_KEY=replace-with-a-different-random-key-of-at-least-32-characters
RESTAURANT_META_ACCESS_TOKEN=replace-with-meta-system-user-access-token
