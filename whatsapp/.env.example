PORT=8080
# Webhook verification only; message sending is disabled.
WHATSAPP_MODE=webhook
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verification-token
# Optional for GET verification; required for signed POST callbacks:
# META_APP_SECRET=your-meta-app-secret
# Later enable WHATSAPP_MODE=messaging and configure:
# META_GRAPH_VERSION=vXX.X
# ORGANIZATIONS_FILE=./config.local.json
# LIBRARY_API_KEY=your-unique-key-of-at-least-32-characters
# LIBRARY_META_ACCESS_TOKEN=your-meta-access-token
